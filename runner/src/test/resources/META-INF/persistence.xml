<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="jakarta-data-tck" transaction-type="JTA">
        <description>Hibernate Entity Manager for Jakarta Data TCK</description>
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>ee.jakarta.tck.data.framework.read.only.AsciiCharacter</class>
        <class>ee.jakarta.tck.data.framework.read.only.NaturalNumber</class>
        <class>ee.jakarta.tck.data.standalone.entity.Box</class>
        <class>ee.jakarta.tck.data.standalone.entity.Coordinate</class>
        <class>ee.jakarta.tck.data.web.validation.Rectangle</class>
        <class>ee.jakarta.tck.data.standalone.persistence.Product</class>
        <class>ee.jakarta.tck.data.framework.read.only._AsciiCharacters</class>
        <class>ee.jakarta.tck.data.framework.read.only._CustomRepository</class>
        <class>ee.jakarta.tck.data.framework.read.only._NaturalNumbers</class>
        <class>ee.jakarta.tck.data.framework.read.only._PositiveIntegers</class>
        <class>ee.jakarta.tck.data.standalone.entity._Boxes</class>
        <class>ee.jakarta.tck.data.standalone.entity._MultipleEntityRepo</class>
        <class>ee.jakarta.tck.data.standalone.persistence.stateless._Catalog</class>
        <class>ee.jakarta.tck.data.standalone.persistence.stateful._Inventory</class>
        <class>ee.jakarta.tck.data.standalone.persistence.stateful._Products</class>

        <class>ee.jakarta.tck.data.framework.read.only.AsciiCharacters</class>
        <class>ee.jakarta.tck.data.framework.read.only.CustomRepository</class>
        <class>ee.jakarta.tck.data.framework.read.only.NaturalNumbers</class>
        <class>ee.jakarta.tck.data.framework.read.only.PositiveIntegers</class>
        <class>ee.jakarta.tck.data.standalone.entity.Boxes</class>
        <class>ee.jakarta.tck.data.standalone.entity.MultipleEntityRepo</class>
        <class>ee.jakarta.tck.data.standalone.persistence.stateless.Catalog</class>
        <class>ee.jakarta.tck.data.standalone.persistence.stateful.Inventory</class>
        <class>ee.jakarta.tck.data.standalone.persistence.stateful.Products</class>

        <class>ee.jakarta.tck.data.framework.read.only.AsciiCharacters$</class>
        <class>ee.jakarta.tck.data.framework.read.only.CustomRepository$</class>
        <class>ee.jakarta.tck.data.framework.read.only.NaturalNumbers$</class>
        <class>ee.jakarta.tck.data.framework.read.only.PositiveIntegers$</class>
        <class>ee.jakarta.tck.data.standalone.persistence.stateless.Catalog$</class>


        <properties>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:./target/h2temp;DB_CLOSE_DELAY=-1" />
            <property name="jakarta.persistence.jdbc.user" value="sa" />
            <property name="jakarta.persistence.jdbc.password" value="" />

            <property name="jakarta.persistence.schema-generation.database.action"
                      value="drop-and-create"/>

            <property name="hibernate.allow_update_outside_transaction" value="true"/>
            <property name="hibernate.connection.autocommit" value="true"/>

            <property name="hibernate.show_sql"   value="true" />
            <property name="hibernate.format_sql" value="true" />
            <property name="hibernate.highlight_sql" value="true" />
        </properties>
    </persistence-unit>
</persistence>